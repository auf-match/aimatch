DATABASE_URL=postgresql://user:password@localhost:5432/auf_match
# Весь AI (парсинг резюме, анализ портфолио, матчинг, скоринг) идёт через Gemini.
GEMINI_API_KEY=your-gemini-api-key
PORT=3001
UPLOAD_DIR=./uploads
NODE_ENV=development
FIGMA_ACCESS_TOKEN=

# HTTP Basic Auth (защита всего приложения).
# В production обе переменные ОБЯЗАТЕЛЬНЫ — иначе сайт вернёт 503.
# В dev можно оставить пустыми — middleware пропустит всех.
# Пароль сгенерируйте через `openssl rand -base64 24` или 1Password.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=


# Токен для внешнего приёма кандидатов (POST /api/candidates/ingest).
# Сгенерируй длинный: openssl rand -base64 24. Отдай консультанту вместе с URL.
INGEST_TOKEN=
